rules_version = '2';
// ITU FIELD OPS 2026 — Firestore security rules.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Owner (full control): g.z.eissa@gmail.com
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function em() { return request.auth.token.email.lower(); }
    function isPM() { return signedIn() && em() in ['g.z.eissa@gmail.com']; }
    function accPath() { return /databases/$(db)/documents/access/$(em()); }
    function acc() { return get(accPath()).data; }
    function hasAcc() { return signedIn() && exists(accPath()); }
    function isSup() { return hasAcc() && acc().role == 'supervisor'; }
    function isAdm() { return hasAcc() && acc().role == 'admin'; }
    // Team account permission switch (set by the owner in Data & import > Team accounts)
    function canP(p) { return isPM() || (isAdm() && (acc().get('perms', {}).get('all', false) == true || acc().get('perms', {}).get(p, false) == true)); }
    function office() { return isPM() || isAdm(); }
    function me() { return acc().staffId; }
    function staffSup(id) { return get(/databases/$(db)/documents/staff/$(id)).data.sup; }

    match /access/{email} {
      allow read: if canP('accounts') || (signedIn() && email == em());
      allow write: if canP('accounts');
    }
    // username -> internal sign-in id. Readable before sign-in so usernames work.
    match /logins/{username} {
      allow read: if true;
      allow write: if canP('accounts');
    }
    // Owner's PDF signature: office accounts read it to print it, only the owner changes it
    match /pmsig/{doc} {
      allow read: if office();
      allow write: if isPM();
    }
    match /config/{doc} {
      allow read: if office() || isSup();
      allow write: if canP('settings');
    }
    match /staff/{id} {
      allow read: if office() || isSup();
      allow write: if canP('staff') || canP('settings');
    }
    // QID numbers: owner, or team accounts with staff/settings permission
    match /staffPrivate/{id} {
      allow read, write: if canP('staff') || canP('settings');
    }
    // One doc per person per day: {date}_{staffId}
    match /attendance/{id} {
      allow read: if office() || (isSup() && resource.data.sup == me());
      allow create: if canP('attendance') || canP('checkin') || canP('staff') || canP('settings') || (isSup() && request.resource.data.sup == me() && staffSup(request.resource.data.staffId) == me());
      allow update: if canP('attendance') || canP('checkin') || canP('staff') || canP('settings') || (isSup() && resource.data.sup == me() && request.resource.data.sup == me() && staffSup(request.resource.data.staffId) == me());
      allow delete: if canP('attendance') || canP('checkin') || canP('staff') || canP('settings') || (isSup() && resource.data.sup == me());
    }
    match /incidents/{id} {
      allow read: if office() || (isSup() && resource.data.byId == me());
      allow create: if office() || (isSup() && request.resource.data.byId == me());
      allow update, delete: if canP('incidents');
    }
    match /announcements/{id} {
      allow read: if office() || isSup();
      allow write: if canP('announcements');
    }
    match /annReads/{id} {
      allow read: if office() || (isSup() && resource.data.staffId == me());
      allow create: if isSup() && request.resource.data.staffId == me();
      allow update, delete: if false;
    }
    // Signed timesheets sent by link: random unguessable id, readable by whoever has the link, never listed.
    match /shared/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if office();
      allow update, delete: if isPM();
    }
    // One phone per account: the first phone to sign in is recorded here (doc id = sign-in email).
    match /devices/{email} {
      allow read: if office() || (signedIn() && email == em());
      allow create: if signedIn() && email == em();
      allow update: if canP('accounts') || (signedIn() && email == em() && resource.data.standalone == false && request.resource.data.standalone == true && !('prev' in resource.data))
        // extra devices: the account adds its own device while under the limit the owner set (access.maxDev)
        || (signedIn() && email == em() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ids'])
            && request.resource.data.ids.hasAll(resource.data.get('ids', []))
            && request.resource.data.ids.size() < acc().get('maxDev', 1));
      allow delete: if canP('accounts');
    }
    // A refused sign-in from another phone alerts the Project Manager.
    match /alerts/{id} {
      allow read: if canP('accounts');
      allow create: if signedIn() && request.resource.data.email == em();
      allow update, delete: if canP('accounts');
    }
    // A supervisor asks for a replacement for one of their own marshals; staff managers answer it.
    match /requests/{id} {
      allow read: if canP('staff') || (isSup() && resource.data.supId == me());
      allow create: if canP('staff') || (isSup() && request.resource.data.supId == me() && request.resource.data.status == 'open' && staffSup(request.resource.data.staffId) == me());
      allow update, delete: if canP('staff');
    }
    // Append-only audit trail. Shift changes need the shifts permission.
    match /audit/{id} {
      allow read: if office();
      allow create: if isPM() || (isAdm() && (request.resource.data.type != 'Shift change' || canP('shifts'))) || (isSup() && request.resource.data.type != 'Shift change');
      allow update, delete: if false;
    }
  }
}
